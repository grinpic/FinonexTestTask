{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "mocha", "@wdio/globals/types"],
    "noEmit": true
  },
  "include": ["config/**/*.ts", "tests/**/*.ts"]
}
