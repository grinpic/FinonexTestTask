{
  "name": "finonex-ios-automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "test": "wdio run config/wdio.browserstack.conf.ts",
    "test:sorting": "npm test -- --spec tests/specs/product-sorting.spec.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run format:check && npm run test:unit",
    "appium:local": "appium --address 127.0.0.1 --port 4723",
    "test:simulator": "wdio run config/wdio.simulator.conf.ts",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "test:drawing": "npm test -- --spec tests/specs/drawing-clear.spec.ts",
    "test:rotation": "npm test -- --spec tests/specs/screen-rotation.spec.ts",
    "test:matrix": "IOS_MATRIX=true wdio run config/wdio.browserstack.conf.ts"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "@wdio/cli": "^9.0.0",
    "@wdio/globals": "^9.0.0",
    "@wdio/local-runner": "^9.0.0",
    "@wdio/mocha-framework": "^9.0.0",
    "@wdio/spec-reporter": "^9.0.0",
    "@wdio/types": "^9.0.0",
    "appium": "^3.8.0",
    "appium-xcuitest-driver": "^12.19.1",
    "dotenv": "^16.0.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "webdriverio": "^9.0.0"
  }
}
